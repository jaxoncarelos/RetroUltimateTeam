class_name PixelFont
extends RefCounted
## Original 5x7 bitmap font built in code, so every Label/Button gets crisp pixel text.
## Base size is 8 (use font sizes 8, 16, 24 … for integer scaling).

const BASE_SIZE := 8
const GLYPH_W := 5
const GLYPH_H := 7
const ADVANCE := 6
const CELL_W := 6
const CELL_H := 8

const GLYPHS := {
