static var _font: FontFile


static func get_font() -> FontFile:
	if _font == null:
		_font = _build()
	return _font


static func _build() -> FontFile:
	var keys: Array = GLYPHS.keys()
	var cols := 16
	var rows := int(ceil(keys.size() / float(cols)))
	var img := Image.create(cols * CELL_W, rows * CELL_H, false, Image.FORMAT_RGBA8)
	img.fill(Color(1, 1, 1, 0))

	var f := FontFile.new()
	f.fixed_size = BASE_SIZE
	f.fixed_size_scale_mode = TextServer.FIXED_SIZE_SCALE_INTEGER_ONLY
	f.antialiasing = TextServer.FONT_ANTIALIASING_NONE
	f.generate_mipmaps = false
	f.allow_system_fallback = false
	var sz := Vector2i(BASE_SIZE, 0)
	f.set_cache_ascent(0, BASE_SIZE, GLYPH_H)
	f.set_cache_descent(0, BASE_SIZE, 2)

	for i in keys.size():
		var ch: String = keys[i]
		var cx := (i % cols) * CELL_W
		var cy := (i / cols) * CELL_H
		var rows_bits: Array = GLYPHS[ch]
		for y in GLYPH_H:
			var line: String = rows_bits[y]
			for x in GLYPH_W:
				if line[x] == "1":
					img.set_pixel(cx + x, cy + y, Color.WHITE)
		var codes: Array[int] = [ch.unicode_at(0)]
		if ch >= "A" and ch <= "Z":
			codes.append(ch.to_lower().unicode_at(0))
		for code in codes:
			f.set_glyph_advance(0, BASE_SIZE, code, Vector2(ADVANCE, 0))
			f.set_glyph_offset(0, sz, code, Vector2(0, -GLYPH_H))
			f.set_glyph_size(0, sz, code, Vector2(GLYPH_W, GLYPH_H))
			f.set_glyph_uv_rect(0, sz, code, Rect2(cx, cy, GLYPH_W, GLYPH_H))
			f.set_glyph_texture_idx(0, sz, code, 0)

	# Space: advance only.
	f.set_glyph_advance(0, BASE_SIZE, 32, Vector2(4, 0))
	f.set_texture_image(0, sz, 0, img)
	return f


## Pixel width of `text` at font size `size` (8, 16, 24…), without the trailing gap.
static func text_width(text: String, size := BASE_SIZE) -> int:
	var w := 0
	for ch in text:
		w += 4 if ch == " " else ADVANCE
	if text.length() > 0 and not text.ends_with(" "):
		w -= 1
	return w * maxi(1, size / BASE_SIZE)
